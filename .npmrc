# expo-router@57 pulls a web-only react-dom that peer-requires react ^19.2.8,
# while Expo SDK 57 pins react 19.2.3. The conflict is confined to the web
# renderer, which this app does not ship — it is iOS first, Android next.
# EAS Build reads this file too, so local and cloud installs resolve the same.
legacy-peer-deps=true
